
# Build stage
FROM golang:1.27.1-alpine AS builder

WORKDIR /src

COPY go.mod ./
COPY server/ ./server/

RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/backend \
    ./server

# Runtime stage
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /

COPY --from=builder /out/backend /backend

ENTRYPOINT ["/backend"]
